# Equilibra - Apache/LiteSpeed configuration.
#
# Source file. scripts/build.ps1 copies it to dist/.htaccess on every build;
# dist/ is wiped and regenerated, so this is the only place to edit it.
#
# Scope: URL canonicalization and response headers. CSP and cache-control are
# deliberately still out.
#
# Rollback: every directive is per-request and reverts the moment this file is
# replaced, except HSTS, which browsers remember for its max-age. That is why
# max-age starts at 5 minutes: the worst case expires while you watch.
#
# scripts/contract_test.py asserts all of this against the deployed site.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /index.html -> / (before host canonicalization, so it stays one hop even
    # when the request arrives on the www host).
    RewriteRule ^index\.html$ https://soyequilibra.com.ar/ [R=301,L,NC,NE]

    # Any host other than the bare apex -> apex, preserving path and query.
    RewriteCond %{HTTP_HOST} !^soyequilibra\.com\.ar$ [NC]
    RewriteRule ^ https://soyequilibra.com.ar%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
    # Stage 1 of the HSTS ramp: 5 minutes, no includeSubDomains, no preload.
    # Browsers cache this directive, so it is the only line here that cannot be
    # taken back by editing the file. Raise to 86400, then 604800, then
    # 2592000, one step per deploy, each after a clean observation window --
    # and raise HSTS_MAX_AGE_STAGE in scripts/contract_test.py in the same
    # commit, or the test will fail on purpose.
    Header always set Strict-Transport-Security "max-age=300"

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"

    # Deny the device APIs the page has no use for. Payment is denied outright:
    # the Easy!Appointments iframe has no payment flow, so it is never handed
    # the capability. Revisit this line if a payment flow is ever added.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
