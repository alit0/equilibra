# Config for the reservation backend. Copy to `.env` and fill real values there;
# `.gitignore` already excludes `.env`. Never commit a populated token.
#
# Required. The Easy!Appointments API token (Settings -> Integrations -> API).
EQUILIBRA_EA_API_TOKEN=

# Optional override for the Easy!Appointments v1 base URL.
# Defaults to https://turnos.allitto.com/index.php/api/v1 (nginx public path,
# proven to forward the Authorization header - EQUILIBRA-014 sonda-token).
#EQUILIBRA_EA_BASE_URL=https://turnos.allitto.com/index.php/api/v1

# Comma-separated browser origins allowed to read responses (CORS). The
# reservation endpoint writes to a medical calendar so '*' is forbidden. Leave
# empty for production (defaults to https://soyequilibra.com.ar); add the dev
# origin here when developing from another host.
EQUILIBRA_ALLOWED_ORIGINS=
